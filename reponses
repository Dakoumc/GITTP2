# Étape 1: Création du répertoire et initialisation
mkdir TP2-VotreNom-VotrePrenom
cd TP2-VotreNom-VotrePrenom
git init
git status

# Étape 2: Création de la branche develop
git branch -m develop
touch README.md
echo "# TP2 : Gestion des branches" > README.md
git add README.md
git commit -m "Ajout du fichier README avec titre"
git status

# Étape 3: Création de la branche feature1
git switch -c feature1
echo "Ceci est une description du projet" >> README.md
git add README.md
git commit -m "Ajout de la description du projet"
git status

# Étape 4: Fusion de feature1 sur develop
git checkout develop
git merge feature1
git status

# Étape 5: Création de la branche feature2
git checkout develop
git switch -c feature2
sed -i '1s/.*/# TP2 - VotreNom-VotrePrenom - Gestion des branches/' README.md
git add README.md
git commit -m "Modification du titre avec nom et prénom"
git status

# Étape 6: Création de la branche feature3
git checkout develop
git switch -c feature3
sed -i '1s/.*/# TP2 - Gestion des branches et fusions/' README.md
git add README.md
git commit -m "Modification du titre avec mention des fusions"
git status

# Étape 7: Fusion des branches sur develop
git checkout develop
git merge feature2
git status
git merge feature3
git status

# Étape 8: Résolution du conflit
# Éditer manuellement le fichier README.md pour garder le titre de feature3
git add README.md
git commit -m "Résolution du conflit en gardant le titre de feature3"
git status

# Configuration du dépôt GitHub
git remote add origin <lien_de_votre_repertoire>
git push -u origin develop

# Partie Rebase
# Étape 1: Création de la branche feature4
git checkout develop
git switch -c feature4
echo "Cette phrase concerne la partie rebase du TP2." >> README.md
sed -i '2s/.*/Ceci est une description du projet dans le fichier README.md/' README.md
git add README.md
git commit -m "Ajout dans README.md - partie rebase"
git status

# Étape 2: Ajout de mention feature4
sed -i 's/Cette phrase concerne la partie rebase du TP2./Cette phrase concerne la partie rebase du TP2. (feature4)/' README.md
git add README.md
git commit -m "Ajout dans README.md - mention feature4"
git status

# Étape 3: Ajout d'une dernière ligne
echo "Fin des modifications de la feature f4" >> README.md
git add README.md
git commit -m "Ajout dans README.md - dernière ligne feature4"
git status

# Étape 4: Fusion (squash) des commits
git log --oneline
git rebase -i HEAD~3
# Dans l'éditeur, modifier pour:
# pick [hash] Ajout dans README.md - partie rebase
# squash [hash] Ajout dans README.md - mention feature4
# squash [hash] Ajout dans README.md - dernière ligne feature4

# Étape 5: Modification du titre sur develop
git checkout develop
sed -i '1s/.*/# TP2 - Branches, merge et rebase - VotreNomEtPrenom/' README.md
git add README.md
git commit -m "Modification du titre pour inclure rebase"
git push origin develop
git status

# Étape 6: Rebase de feature4 sur develop
git checkout feature4
git rebase develop
# En cas de conflit:
# Éditer manuellement le fichier README.md
git add README.md
git rebase --continue
git status

# Étape 9: Pousser les modifications après rebase
git checkout develop
git merge feature4
git push origin develop

# Création du fichier de réponses
touch reponses.txt

# Ajouter au fichier de réponses:
echo "7. Explication de la commande merge:" >> reponses.txt
echo "La commande merge permet de fusionner les modifications d'une branche dans une autre. Elle crée un nouveau commit de fusion qui a deux parents, préservant l'historique complet des deux branches. Le merge est utile pour intégrer des fonctionnalités terminées dans la branche principale." >> reponses.txt

echo "8. Explication de la commande rebase:" >> reponses.txt
echo "La commande rebase permet de déplacer ou combiner une séquence de commits sur un nouvel commit de base. Contrairement au merge, elle réécrit l'historique en créant de nouveaux commits. Dans ce TP, elle nous a été utile pour maintenir un historique plus propre et linéaire, et pour regrouper (squash) plusieurs commits en un seul, ce qui permet d'avoir un historique plus compréhensible et organisé." >> reponses.txt

echo "10. Schéma de branches pour la partie rebase:" >> reponses.txt
echo "develop: o---o---o---o (HEAD -> develop, origin/develop)" >> reponses.txt
echo "              \\" >> reponses.txt
echo "feature4:      o (feature4)" >> reponses.txt
echo "" >> reponses.txt
echo "Après le rebase et merge:" >> reponses.txt
echo "develop: o---o---o---o---o (HEAD -> develop, origin/develop)" >> reponses.txt

# Finalisation et envoi du fichier de réponses
git checkout develop
git add reponses.txt
git commit -m "Ajout du fichier de réponses"
git push origin develop



7. La commande merge:
La commande merge permet de fusionner les modifications d'une branche dans une autre. Cela crée un nouveau commit de fusion (merge commit) qui a deux parents, sauf dans le cas d'un fast-forward. Elle préserve l'historique complet.

8. La commande rebase:
La commande rebase permet de déplacer ou combiner une séquence de commits sur un nouvel commit de base. Contrairement au merge, elle réécrit l'historique en créant de nouveaux commits. Dans ce TP, elle nous a été utile pour maintenir un historique plus propre et linéaire, et pour regrouper (squash) plusieurs commits en un seul.

9. Pour pousser les dernières modifications:
git checkout develop
git push origin develop
